setuptools==59.6.0

# Dependencies the tools above don't cap, held at releases they work with.
anyio<4                  # 4's pytest plugin needs pytest 7
cmsis-pack-manager<0.3   # pyocd: 0.3 has no wheel (needs Rust); 0.4+ needs pyyaml 6
flask<2                  # dash 1.14
itsdangerous<2.1         # flask 1
jinja2<3.1               # flask 1 and flake8-html import names 3.1 removed
markupsafe<2.1           # jinja2 2
typed-ast>=1.5           # black 19.10b0: older releases don't load on 3.10
werkzeug<2.1             # flask 1
